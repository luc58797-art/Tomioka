
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let W = innerWidth;
let H = innerHeight;

function resize() {
    W = innerWidth;
    H = innerHeight;
    canvas.width = W;
    canvas.height = H;
}

resize();
addEventListener("resize", resize);

const player = {
    x: W / 2,
    y: H / 2,
    r: 18,
    speed: 3.8,
    hp: 100,
    maxHp: 100,
    level: 1,
    xp: 0,
    xpNext: 100,
    coins: 0,
    attackCooldown: 0,
    invincible: 0
};

const enemies = [];
const projectiles = [];
const particles = [];
const floatingTexts = [];

const keys = {};
const joystick = {
    active: false,
    x: 0,
    y: 0,
    dx: 0,
    dy: 0,
    max: 55
};

let attackPressed = false;
let gameOver = false;
let spawnTimer = 0;
let cameraShake = 0;

function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
}

function distance(a, b) {
    return Math.hypot(a.x - b.x, a.y - b.y);
}

function random(min, max) {
    return Math.random() * (max - min) + min;
}

function nearestEnemy() {
    let best = null;
    let bestDist = Infinity;

    for (const e of enemies) {
        const d = distance(player, e);

        if (d < bestDist) {
            bestDist = d;
            best = e;
        }
    }

    return best;
}

function addParticle(x, y, color, amount = 8) {
    for (let i = 0; i < amount; i++) {
        particles.push({
            x,
            y,
            vx: random(-2.5, 2.5),
            vy: random(-2.5, 2.5),
            life: random(20, 45),
            maxLife: 45,
            size: random(2, 5),
            color
        });
    }
}

function text(x, y, value, color = "#fff") {
    floatingTexts.push({
        x,
        y,
        value,
        color,
        life: 50
    });
}

function spawnEnemy() {
    const side = Math.floor(random(0, 4));

    let x;
    let y;

    if (side === 0) {
        x = random(20, W - 20);
        y = -30;
    } else if (side === 1) {
        x = W + 30;
        y = random(80, H - 20);
    } else if (side === 2) {
        x = random(20, W - 20);
        y = H + 30;
    } else {
        x = -30;
        y = random(80, H - 20);
    }

    const types = [
        {
            name: "Slime",
            color: "#65d66e",
            r: 18,
            hp: 35,
            speed: 1.15,
            damage: 8,
            xp: 20,
            coins: 3
        },
        {
            name: "Demônio",
            color: "#d94b63",
            r: 21,
            hp: 55,
            speed: 0.85,
            damage: 12,
            xp: 32,
            coins: 5
        },
        {
            name: "Espírito",
            color: "#a78bfa",
            r: 16,
            hp: 28,
            speed: 1.7,
            damage: 6,
            xp: 25,
            coins: 4
        }
    ];

    const base = types[Math.floor(random(0, types.length))];

    const scale = 1 + (player.level - 1) * 0.12;

    enemies.push({
        x,
        y,
        r: base.r,
        name: base.name,
        color: base.color,
        hp: Math.floor(base.hp * scale),
        maxHp: Math.floor(base.hp * scale),
        speed: base.speed + player.level * 0.025,
        damage: base.damage + Math.floor(player.level * 0.5),
        xp: base.xp,
        coins: base.coins
    });
}

function attack() {
    if (gameOver) return;
    if (player.attackCooldown > 0) return;

    const target = nearestEnemy();

    if (!target) return;

    const angle = Math.atan2(
        target.y - player.y,
        target.x - player.x
    );

    projectiles.push({
        x: player.x,
        y: player.y,
        vx: Math.cos(angle) * 8,
        vy: Math.sin(angle) * 8,
        r: 8,
        damage: 25 + player.level * 5,
        life: 80
    });

    player.attackCooldown = 18;

    addParticle(
        player.x + Math.cos(angle) * 20,
        player.y + Math.sin(angle) * 20,
        "#38bdf8",
        5
    );
}

function gainXP(value) {
    player.xp += value;

    while (player.xp >= player.xpNext) {
        player.xp -= player.xpNext;
        player.level++;

        player.xpNext = Math.floor(player.xpNext * 1.35);

        player.maxHp += 15;
        player.hp = player.maxHp;

        text(
            player.x,
            player.y - 45,
            "LEVEL UP!",
            "#facc15"
        );

        addParticle(
            player.x,
            player.y,
            "#facc15",
            30
        );
    }
}

function killEnemy(enemy) {
    const index = enemies.indexOf(enemy);

    if (index !== -1)
        enemies.splice(index, 1);

    player.coins += enemy.coins;

    gainXP(enemy.xp);

    text(
        enemy.x,
        enemy.y - 25,
        "+" + enemy.xp + " XP",
        "#93c5fd"
    );

    addParticle(
        enemy.x,
        enemy.y,
        enemy.color,
        20
    );

    cameraShake = 5;
}

function update() {
    if (gameOver) return;

    let dx = 0;
    let dy = 0;

    if (keys["w"] || keys["arrowup"]) dy--;
    if (keys["s"] || keys["arrowdown"]) dy++;
    if (keys["a"] || keys["arrowleft"]) dx--;
    if (keys["d"] || keys["arrowright"]) dx++;

    if (joystick.active) {
        dx += joystick.dx;
        dy += joystick.dy;
    }

    const len = Math.hypot(dx, dy);

    if (len > 0) {
        dx /= len;
        dy /= len;

        player.x += dx * player.speed;
        player.y += dy * player.speed;
    }

    player.x = clamp(player.x, 25, W - 25);
    player.y = clamp(player.y, 90, H - 25);

    if (player.attackCooldown > 0)
        player.attackCooldown--;

    if (player.invincible > 0)
        player.invincible--;

    if (attackPressed)
        attack();

    spawnTimer--;

    const maxEnemies =
        Math.min(18, 4 + player.level * 2);

    if (
        spawnTimer <= 0 &&
        enemies.length < maxEnemies
    ) {
        spawnEnemy();

        spawnTimer =
            Math.max(25, 80 - player.level * 3);
    }

    for (const enemy of enemies) {
        const angle = Math.atan2(
            player.y - enemy.y,
            player.x - enemy.x
        );

        enemy.x += Math.cos(angle) * enemy.speed;
        enemy.y += Math.sin(angle) * enemy.speed;

        const d = distance(player, enemy);

        if (d < player.r + enemy.r) {
            if (player.invincible <= 0) {
                player.hp -= enemy.damage;

                player.invincible = 35;

                text(
                    player.x,
                    player.y - 35,
                    "-" + enemy.damage,
                    "#ef4444"
                );

                addParticle(
                    player.x,
                    player.y,
                    "#ef4444",
                    8
                );

                cameraShake = 7;

                if (player.hp <= 0) {
                    player.hp = 0;
                    gameOver = true;
                }
            }
        }
    }

    for (let i = projectiles.length - 1; i >= 0; i--) {
        const p = projectiles[i];

        p.x += p.vx;
        p.y += p.vy;
        p.life--;

        let removed = false;

        for (const enemy of enemies) {
            if (distance(p, enemy) < p.r + enemy.r) {

                enemy.hp -= p.damage;

                addParticle(
                    p.x,
                    p.y,
                    "#38bdf8",
                    8
                );

                text(
                    enemy.x,
                    enemy.y - 20,
                    "-" + p.damage,
                    "#7dd3fc"
                );

                projectiles.splice(i, 1);
                removed = true;

                if (enemy.hp <= 0)
                    killEnemy(enemy);

                break;
            }
        }

        if (
            !removed &&
            (
                p.life <= 0 ||
                p.x < -50 ||
                p.x > W + 50 ||
                p.y < -50 ||
                p.y > H + 50
            )
        ) {
            projectiles.splice(i, 1);
        }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];

        p.x += p.vx;
        p.y += p.vy;

        p.vx *= 0.97;
        p.vy *= 0.97;

        p.life--;

        if (p.life <= 0)
            particles.splice(i, 1);
    }

    for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const t = floatingTexts[i];

        t.y -= 0.6;
        t.life--;

        if (t.life <= 0)
            floatingTexts.splice(i, 1);
    }

    if (cameraShake > 0)
        cameraShake *= 0.8;
}

function drawBackground() {
    ctx.fillStyle = "#071b22";
    ctx.fillRect(0, 0, W, H);

    // grama
    ctx.fillStyle = "#0c302b";
    ctx.fillRect(0, 70, W, H - 70);

    // caminhos
    ctx.fillStyle = "#16423a";

    for (let y = 120; y < H; y += 120) {
        ctx.fillRect(0, y, W, 42);
    }

    // pequenas pedras
    for (let x = 20; x < W; x += 90) {
        for (let y = 100; y < H; y += 110) {
            ctx.fillStyle = "#1d5146";
            ctx.beginPath();
            ctx.arc(
                x + Math.sin(y) * 8,
                y,
                4,
                0,
                Math.PI * 2
            );
            ctx.fill();
        }
    }

    // árvores decorativas
    for (let x = 35; x < W; x += 145) {
        const y = 105 + (x % 230);

        if (y > H - 50) continue;

        ctx.fillStyle = "#422d20";
        ctx.fillRect(x - 5, y, 10, 25);

        ctx.fillStyle = "#166534";
        ctx.beginPath();
        ctx.arc(x, y - 5, 24, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#15803d";
        ctx.beginPath();
        ctx.arc(x - 15, y + 5, 15, 0, Math.PI * 2);
        ctx.fill();
    }
}

function drawPlayer() {
    if (
        player.invincible > 0 &&
        Math.floor(player.invincible / 4) % 2 === 0
    )
        return;

    // sombra
    ctx.fillStyle = "rgba(0,0,0,.3)";
    ctx.beginPath();
    ctx.ellipse(
        player.x,
        player.y + 18,
        21,
        8,
        0,
        0,
        Math.PI * 2
    );
    ctx.fill();

    // corpo
    const gradient = ctx.createLinearGradient(
        player.x - 20,
        player.y - 20,
        player.x + 20,
        player.y + 20
    );

    gradient.addColorStop(0, "#60a5fa");
    gradient.addColorStop(1, "#1d4ed8");

    ctx.fillStyle = gradient;

    ctx.beginPath();
    ctx.roundRect(
        player.x - 17,
        player.y - 5,
        34,
        38,
        8
    );
    ctx.fill();

    // cabeça
    ctx.fillStyle = "#f5d0a9";

    ctx.beginPath();
    ctx.arc(
        player.x,
        player.y - 15,
        14,
        0,
        Math.PI * 2
    );
    ctx.fill();

    // cabelo
    ctx.fillStyle = "#172554";

    ctx.beginPath();
    ctx.arc(
        player.x,
        player.y - 21,
        15,
        Math.PI,
        Math.PI * 2
    );
    ctx.fill();

    // olhos
    ctx.fillStyle = "#111827";

    ctx.fillRect(
        player.x - 7,
        player.y - 16,
        3,
        3
    );

    ctx.fillRect(
        player.x + 4,
        player.y - 16,
        3,
        3
    );

    // nome
    ctx.fillStyle = "#fff";
    ctx.font = "bold 13px Arial";
    ctx.textAlign = "center";
    ctx.fillText(
        "Tomioka",
        player.x,
        player.y - 38
    );

    ctx.textAlign = "left";
}

function drawEnemy(enemy) {
    // sombra
    ctx.fillStyle = "rgba(0,0,0,.35)";
    ctx.beginPath();
    ctx.ellipse(
        enemy.x,
        enemy.y + enemy.r,
        enemy.r,
        enemy.r / 3,
        0,
        0,
        Math.PI * 2
    );
    ctx.fill();

    ctx.fillStyle = enemy.color;

    ctx.beginPath();
    ctx.arc(
        enemy.x,
        enemy.y,
        enemy.r,
        0,
        Math.PI * 2
    );
    ctx.fill();

    // olhos
    ctx.fillStyle = "#111";

    ctx.beginPath();
    ctx.arc(
        enemy.x - enemy.r * 0.35,
        enemy.y - 3,
        3,
        0,
        Math.PI * 2
    );
    ctx.arc(
        enemy.x + enemy.r * 0.35,
        enemy.y - 3,
        3,
        0,
        Math.PI * 2
    );
    ctx.fill();

    // barra de vida
    const width = enemy.r * 2.4;

    ctx.fillStyle = "#111827";
    ctx.fillRect(
        enemy.x - width / 2,
        enemy.y - enemy.r - 10,
        width,
        5
    );

    ctx.fillStyle = "#ef4444";
    ctx.fillRect(
        enemy.x - width / 2,
        enemy.y - enemy.r - 10,
        width * (enemy.hp / enemy.maxHp),
        5
    );
}

function drawProjectiles() {
    for (const p of projectiles) {
        const g = ctx.createRadialGradient(
            p.x,
            p.y,
            1,
            p.x,
            p.y,
            12
        );

        g.addColorStop(0, "#e0f2fe");
        g.addColorStop(1, "#0284c7");

        ctx.fillStyle = g;

        ctx.beginPath();
        ctx.arc(
            p.x,
            p.y,
            p.r,
            0,
            Math.PI * 2
        );
        ctx.fill();
    }
}

function drawParticles() {
    for (const p of particles) {
        ctx.globalAlpha =
            p.life / p.maxLife;

        ctx.fillStyle = p.color;

        ctx.beginPath();
        ctx.arc(
            p.x,
            p.y,
            p.size,
            0,
            Math.PI * 2
        );
        ctx.fill();
    }

    ctx.globalAlpha = 1;
}

function drawTexts() {
    ctx.textAlign = "center";
    ctx.font = "bold 14px Arial";

    for (const t of floatingTexts) {
        ctx.globalAlpha =
            Math.min(1, t.life / 20);

        ctx.fillStyle = t.color;

        ctx.fillText(
            t.value,
            t.x,
            t.y
        );
    }

    ctx.globalAlpha = 1;
    ctx.textAlign = "left";
}

function drawHUD() {
    // painel
    ctx.fillStyle = "rgba(3,7,18,.88)";
    ctx.fillRect(0, 0, W, 74);

    ctx.fillStyle = "#fff";
    ctx.font = "bold 16px Arial";

    ctx.fillText(
        "🌊 LV " + player.level,
        15,
        25
    );

    ctx.fillText(
        "💰 " + player.coins,
        15,
        51
    );

    // vida
    ctx.fillStyle = "#1f2937";
    ctx.fillRect(
        105,
        14,
        Math.min(190, W - 130),
        20
    );

    ctx.fillStyle = "#22c55e";
    ctx.fillRect(
        105,
        14,
        Math.min(190, W - 130) *
        (player.hp / player.maxHp),
        20
    );

    ctx.fillStyle = "#fff";
    ctx.font = "bold 12px Arial";
    ctx.textAlign = "center";

    ctx.fillText(
        `${player.hp}/${player.maxHp}`,
        105 + Math.min(190, W - 130) / 2,
        29
    );

    // XP
    ctx.fillStyle = "#1f2937";

    ctx.fillRect(
        105,
        40,
        Math.min(190, W - 130),
        10
    );

    ctx.fillStyle = "#a855f7";

    ctx.fillRect(
        105,
        40,
        Math.min(190, W - 130) *
        (player.xp / player.xpNext),
        10
    );

    ctx.textAlign = "left";

    // inimigos
    ctx.fillStyle = "#fff";
    ctx.font = "12px Arial";

    ctx.fillText(
        "👾 " + enemies.length,
        W - 55,
        27
    );
}

function drawJoystick() {
    const baseX = 85;
    const baseY = H - 100;

    ctx.globalAlpha = 0.75;

    ctx.fillStyle = "rgba(255,255,255,.12)";

    ctx.beginPath();
    ctx.arc(
        baseX,
        baseY,
        62,
        0,
        Math.PI * 2
    );
    ctx.fill();

    ctx.strokeStyle = "rgba(255,255,255,.25)";
    ctx.lineWidth = 2;

    ctx.stroke();

    const knobX =
        baseX + joystick.dx * 45;

    const knobY =
        baseY + joystick.dy * 45;

    ctx.fillStyle = "rgba(96,165,250,.85)";

    ctx.beginPath();
    ctx.arc(
        knobX,
        knobY,
        28,
        0,
        Math.PI * 2
    );
    ctx.fill();

    ctx.globalAlpha = 1;
}

function drawAttackButton() {
    const x = W - 85;
    const y = H - 100;

    ctx.fillStyle =
        attackPressed
            ? "rgba(14,165,233,.95)"
            : "rgba(30,64,175,.85)";

    ctx.beginPath();
    ctx.arc(
        x,
        y,
        52,
        0,
        Math.PI * 2
    );
    ctx.fill();

    ctx.strokeStyle = "rgba(255,255,255,.5)";
    ctx.lineWidth = 3;
    ctx.stroke();

    ctx.fillStyle = "#fff";
    ctx.font = "bold 14px Arial";
    ctx.textAlign = "center";

    ctx.fillText(
        "ATACAR",
        x,
        y + 5
    );

    ctx.textAlign = "left";
}

function drawGameOver() {
    if (!gameOver) return;

    ctx.fillStyle = "rgba(0,0,0,.72)";
    ctx.fillRect(
        0,
        0,
        W,
        H
    );

    ctx.textAlign = "center";

    ctx.fillStyle = "#fff";
    ctx.font = "bold 32px Arial";

    ctx.fillText(
        "💀 VOCÊ MORREU",
        W / 2,
        H / 2 - 45
    );

    ctx.font = "18px Arial";

    ctx.fillText(
        `Nível ${player.level} • 💰 ${player.coins}`,
        W / 2,
        H / 2
    );

    ctx.fillStyle = "#38bdf8";

    ctx.fillText(
        "Toque na tela para reiniciar",
        W / 2,
        H / 2 + 45
    );

    ctx.textAlign = "left";
}

function draw() {
    ctx.save();

    if (cameraShake > 0) {
        ctx.translate(
            random(-cameraShake, cameraShake),
            random(-cameraShake, cameraShake)
        );
    }

    drawBackground();

    for (const enemy of enemies)
        drawEnemy(enemy);

    drawProjectiles();
    drawParticles();
    drawPlayer();
    drawTexts();

    ctx.restore();

    drawHUD();
    drawJoystick();
    drawAttackButton();
    drawGameOver();
}

function loop() {
    update();
    draw();

    requestAnimationFrame(loop);
}

function resetGame() {
    player.x = W / 2;
    player.y = H / 2;
    player.hp = 100;
    player.maxHp = 100;
    player.level = 1;
    player.xp = 0;
    player.xpNext = 100;
    player.coins = 0;

    enemies.length = 0;
    projectiles.length = 0;
    particles.length = 0;
    floatingTexts.length = 0;

    gameOver = false;
    spawnTimer = 0;
}

function touchPosition(touch) {
    return {
        x: touch.clientX,
        y: touch.clientY
    };
}

canvas.addEventListener("touchstart", e => {
    e.preventDefault();

    if (gameOver) {
        resetGame();
        return;
    }

    for (const touch of e.changedTouches) {
        const p = touchPosition(touch);

        const dx = p.x - 85;
        const dy = p.y - (H - 100);

        if (Math.hypot(dx, dy) < 90) {
            joystick.active = true;

            updateJoystick(
                p.x,
                p.y
            );
        }

        const ax = p.x - (W - 85);
        const ay = p.y - (H - 100);

        if (Math.hypot(ax, ay) < 75) {
            attackPressed = true;
            attack();
        }
    }
}, { passive: false });

canvas.addEventListener("touchmove", e => {
    e.preventDefault();

    for (const touch of e.changedTouches) {
        const p = touchPosition(touch);

        if (joystick.active)
            updateJoystick(
                p.x,
                p.y
            );
    }
}, { passive: false });

canvas.addEventListener("touchend", e => {
    e.preventDefault();

    joystick.active = false;
    joystick.dx = 0;
    joystick.dy = 0;
    attackPressed = false;
}, { passive: false });

canvas.addEventListener("touchcancel", () => {
    joystick.active = false;
    joystick.dx = 0;
    joystick.dy = 0;
    attackPressed = false;
});

function updateJoystick(x, y) {
    const baseX = 85;
    const baseY = H - 100;

    let dx = x - baseX;
    let dy = y - baseY;

    const len = Math.hypot(dx, dy);

    if (len > joystick.max) {
        dx =
            dx / len *
            joystick.max;

        dy =
            dy / len *
            joystick.max;
    }

    joystick.dx =
        dx / joystick.max;

    joystick.dy =
        dy / joystick.max;
}

addEventListener("keydown", e => {
    keys[e.key.toLowerCase()] = true;

    if (e.code === "Space") {
        attackPressed = true;
        attack();
    }
});

addEventListener("keyup", e => {
    keys[e.key.toLowerCase()] = false;

    if (e.code === "Space")
        attackPressed = false;
});

loop();
