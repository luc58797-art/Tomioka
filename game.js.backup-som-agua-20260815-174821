    x: W / 2,
    y: H / 2,
    r: 20,
    speed: 4.2,
    hp: 100,
    maxHp: 100,
    level: 1,
    xp: 0,
    xpNext: 100,
    coins: 0,

    attackCooldown: 0,
    invincible: 0,
    dashCooldown: 0,

    facing: 0,

    mastery: 0,
    masteryMax: 50,
    technique: 0
};

