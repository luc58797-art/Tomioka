<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#050914">
<title>Aventura Tomioka</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050914;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
}

body {
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
    width: 100vw;
    height: 100vh;
    touch-action: none;
}

#loading {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    background: radial-gradient(circle at center, #102b45, #050914 70%);
    color: white;
    font-size: 24px;
    font-weight: bold;
}

#loading small {
    font-size: 13px;
    opacity: .6;
    font-weight: normal;
}

#startScreen {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(4,15,31,.92), rgba(3,7,18,.98));
    color: white;
    text-align: center;
}

#startScreen h1 {
    font-size: clamp(30px, 8vw, 58px);
    margin-bottom: 8px;
    text-shadow: 0 0 25px rgba(56,189,248,.8);
}

#startScreen p {
    opacity: .7;
    margin-bottom: 25px;
}

#startButton {
    border: 2px solid rgba(125,211,252,.8);
    background: linear-gradient(135deg, #0369a1, #1d4ed8);
    color: white;
    padding: 16px 38px;
    border-radius: 18px;
    font-size: 18px;
    font-weight: bold;
    box-shadow: 0 8px 30px rgba(14,165,233,.3);
}

#startButton:active {
    transform: scale(.94);
}

.hidden {
    display: none !important;
}

#rotate-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px;
    background:
        radial-gradient(circle at center, #123b52 0%, #050912 75%);
    color: white;
    font-family: Arial, sans-serif;
}

#rotate-screen .box {
    max-width: 420px;
}

#rotate-screen .icon {
    font-size: 64px;
    margin-bottom: 15px;
}

#rotate-screen h1 {
    font-size: 25px;
    margin-bottom: 10px;
}

#rotate-screen p {
    color: #bae6fd;
    font-size: 15px;
}

@media (orientation: portrait) {
    #rotate-screen {
        display: flex;
    }
}

@media (orientation: landscape) {
    #rotate-screen {
        display: none;
    }
}
</style>
</head>

<body>

<div id="loading">
    🌊 AVENTURA TOMIOKA
    <small>Carregando...</small>
</div>

<div id="startScreen" class="hidden">
    <h1>🌊 TOMIOKA</h1>
    <p>Sobreviva. Evolua. Derrote todos.</p>
    <button id="startButton">▶ JOGAR</button>
</div>


<div id="rotate-screen">
    <div class="box">
        <div class="icon">📱↔️</div>
        <h1>Vire o celular de lado</h1>
        <p>
            A Aventura Tomioka foi preparada para jogar em
            modo horizontal.
        </p>
    </div>
</div>

<canvas id="game"></canvas>


<script src="game.js"></script>

</body>
</html>
